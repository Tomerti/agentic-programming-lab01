# The game is plain JavaScript with no build step and no npm dependencies, so there is
# no build output or dependency folder to ignore. Node.js runs the tools and Python's
# http.server serves the page locally. Add entries here if the tooling grows.

# Secrets and local configuration
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Brainstorming companion sessions (superpowers)
.superpowers/
